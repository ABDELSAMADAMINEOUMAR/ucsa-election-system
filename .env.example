# Public Supabase project URL and publishable key. Publishable keys are safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55021
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Storage upload key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Local integration-test keys only. Obtain from `supabase status -o env` for the disposable local stack.
SUPABASE_TEST_SECRET_KEY=local_supabase_secret_key
SUPABASE_TEST_JWT_SECRET=local_supabase_jwt_secret

# Generate these and the private signing-key file with npm run local:secrets.
# Never use the placeholders below as live credentials.
SUPABASE_LOCAL_JWT_SECRET=generated_by_npm_run_local_secrets
SUPABASE_LOCAL_SECRET_KEY=sb_secret_generated_by_npm_run_local_secrets
SUPABASE_LOCAL_PUBLISHABLE_KEY=sb_publishable_generated_by_npm_run_local_secrets

# Management deployment defaults. No real-voting flag exists.
UCSA_DEPLOYMENT_MODE=management
UCSA_SYNTHETIC_VOTING_ENABLED=false
UCSA_PUBLIC_REGISTRATION_ENABLED=false
